# Asset Finder settings
# -----------------------------------------------------------------------------
# Fill in STEP 1, then save (Ctrl+S) and close. Leave everything else as it is.
# This file holds your token. It stays on this computer and is never shared.
# Write each value straight after "=" - no spaces, no quotes.


# ---- STEP 1: your model runner (Unsloth OR Ollama) --------------------------
#
#                  UNSLOTH                            OLLAMA
#   LLM_BASE_URL   http://127.0.0.1:8888/v1           http://localhost:11434/v1
#   LLM_MODEL      Qwen/Qwen3-VL-4B-Instruct-GGUF     qwen3-vl:4b
#   LLM_API_KEY    your token (starts sk-unsloth-)    ollama
#
# Filled in for Unsloth below - just paste your token.
# Using Ollama? Change all three lines to the Ollama column.
#
# The model must read pictures as well as text (a "VL" model):
#   Unsloth: download it together with its vision file (mmproj).
#   Ollama:  type  ollama pull qwen3-vl:4b  once;  ollama list  shows its name.

# Address of your model runner.
LLM_BASE_URL=http://127.0.0.1:8888/v1

# Model name, exactly as your model runner shows it.
LLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-GGUF

# Token. Unsloth: Settings -> API -> Create. Ollama: type ollama.
# Never leave it empty - with no token the app does not use the model at all.
LLM_API_KEY=


# ---- Leave these as they are ------------------------------------------------

# Seconds to wait for the model before giving up on one request.
LLM_TIMEOUT_SECONDS=90

# Picture reading. Blank = the same model and address as above.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# The search model. It runs inside the app, not in Unsloth or Ollama.
# If you ever change it, give CHROMA_DIR and STATUS_FILE new names too, then
# press "Process the files" to read your library again.
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
# Blank = chosen automatically to suit the search model.
EMBEDDING_QUERY_PREFIX=

# Where the search index, and the record of what was read, are kept.
CHROMA_DIR=./chroma_store_local
STATUS_FILE=./index_status_local.json

# Starting content folder. You pick your real folder inside the app.
ASSETS_FOLDER=./content

# How good a result must be to count as a match (tuned for the search model).
SIMILARITY_THRESHOLD=0.68
# How close a result must be to appear under "Show closest".
CLOSEST_THRESHOLD=0.60

# Results fetched per search, how many get an AI explanation, and the most
# shown under "Show closest".
TOP_K=10
WHY_TOP_N=5
CLOSEST_FEW=3
